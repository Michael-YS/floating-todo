<Window x:Class="FloatingTodo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Floating Todo" Width="360" MinHeight="170" MaxHeight="900"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False" SizeToContent="Height"
        MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave"
        PreviewMouseDown="Window_PreviewMouseDown"
        Deactivated="Window_Deactivated">
  <Border Background="#FF1B191E" BorderBrush="#45FFFFFF" BorderThickness="1"
          CornerRadius="15" Padding="18,16,18,18">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,12" MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="TODO" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Ellipse Width="7" Height="7" Fill="#55C9B0" Margin="10,1,0,0" ToolTip="本地原型 · 等待接入 CalDAV" />
        </StackPanel>
        <TextBlock Grid.Column="1" x:Name="SyncText" Text="本地" Foreground="{StaticResource SecondaryText}"
                   FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
        <Button Grid.Column="2" x:Name="AddButton" Content="＋" Style="{StaticResource IconButton}" FontSize="24"
                Padding="5,0" ToolTip="新建任务" Click="AddButton_Click" />
      </Grid>

      <Border Grid.Row="1" x:Name="NewTaskPanel" Visibility="Collapsed" Background="#28000000"
              BorderBrush="#36FFFFFF" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,0,0,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button x:Name="NewListButton" Width="5" Height="34" Padding="0" Background="#55C9B0"
                  BorderThickness="0" Cursor="Hand" Click="NewListButton_Click"
                  ToolTip="个人 · 单击切换清单" />
          <TextBox Grid.Column="1" x:Name="NewTitleBox" Background="Transparent" BorderThickness="0"
                   Foreground="{StaticResource PrimaryText}" CaretBrush="White" FontFamily="{StaticResource UiFont}"
                   FontSize="14" Padding="9,7" KeyDown="NewTitleBox_KeyDown" ToolTip="输入标题后按 Enter" />
          <Button Grid.Column="2" x:Name="DateButton" Content="今天" Style="{StaticResource IconButton}"
                  Foreground="{StaticResource SecondaryText}" FontSize="12" Click="DateButton_Click" />
        </Grid>
      </Border>

      <Popup x:Name="DatePopup" PlacementTarget="{Binding ElementName=DateButton}" Placement="Bottom"
             StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
        <Border Background="#F5222026" BorderBrush="#55FFFFFF" BorderThickness="1" CornerRadius="12"
                Padding="12" Margin="0,6,0,0">
          <StackPanel Width="270">
            <UniformGrid Columns="4" Margin="0,0,0,10">
              <Button Content="今天" Tag="today" Click="QuickDate_Click" Padding="5" Margin="2" />
              <Button Content="明天" Tag="tomorrow" Click="QuickDate_Click" Padding="5" Margin="2" />
              <Button Content="本周六" Tag="saturday" Click="QuickDate_Click" Padding="5" Margin="2" />
              <Button Content="无日期" Tag="none" Click="QuickDate_Click" Padding="5" Margin="2" />
            </UniformGrid>
            <Calendar x:Name="DueCalendar" SelectedDatesChanged="DueCalendar_SelectedDatesChanged" />
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="ManualDateBox" Style="{StaticResource GlassTextBox}" ToolTip="2026-07-25、7/25、7月25日" />
              <Button Grid.Column="1" Content="确定" Margin="8,0,0,0" Padding="12,6" Click="ManualDate_Click" />
            </Grid>
            <TextBlock x:Name="DateErrorText" Foreground="#FF8A86" FontSize="11" Margin="2,6,0,0" />
          </StackPanel>
        </Border>
      </Popup>

      <ScrollViewer Grid.Row="2" x:Name="TaskScroll" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" MaxHeight="780">
        <StackPanel x:Name="GroupsPanel" />
      </ScrollViewer>
    </Grid>
  </Border>
</Window>
