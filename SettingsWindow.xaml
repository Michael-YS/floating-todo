<Window x:Class="FloatingTodo.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Floating Todo 设置" Width="640" Height="720"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
  <Border Background="#F51B191E" BorderBrush="#45FFFFFF" BorderThickness="1" CornerRadius="16" Padding="24">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Margin="0,0,0,18" MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="设置" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Text="外观、启动、账号与同步" Foreground="{StaticResource SecondaryText}" FontSize="12" Margin="0,4,0,0" />
        </StackPanel>
        <Button Grid.Column="1" Content="✕" Style="{StaticResource IconButton}" Click="Close_Click" />
      </Grid>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="应用" FontSize="15" FontWeight="SemiBold" />
          <Border Background="#1FFFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1"
                  CornerRadius="12" Padding="16" Margin="0,10,0,22">
            <StackPanel>
              <CheckBox x:Name="StartWithWindowsCheckBox"
                        Content="登录 Windows 时自动启动"
                        Foreground="{StaticResource PrimaryText}"
                        FontSize="14"
                        Checked="StartWithWindows_Changed"
                        Unchecked="StartWithWindows_Changed" />
              <TextBlock x:Name="StartupStatusText"
                         Text="使用当前用户启动项，不需要管理员权限。"
                         Foreground="{StaticResource SecondaryText}"
                         FontSize="11"
                         Margin="24,6,0,0" />

              <Border Height="1" Background="#24FFFFFF" Margin="0,16,0,14" />

              <CheckBox x:Name="PowerSavingCheckBox" Content="省电模式"
                        Foreground="{StaticResource PrimaryText}" FontSize="14" />
              <TextBlock Text="同步约 15–20 分钟，任务分组每 5 分钟，撤销倒计时每 5 秒刷新。" Foreground="{StaticResource SecondaryText}"
                         FontSize="11" Margin="24,6,0,0" />
              <Border Height="1" Background="#24FFFFFF" Margin="0,16,0,14" />

              <TextBlock Text="HUD 透明度"
                         Foreground="{StaticResource PrimaryText}"
                         FontSize="14" />
              <Grid Margin="0,9,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="68" />
                </Grid.ColumnDefinitions>
                <Slider x:Name="OpacitySlider"
                        Minimum="0" Maximum="100" Value="100"
                        TickFrequency="1" IsSnapToTickEnabled="True"
                        VerticalAlignment="Center">
                  <Slider.Resources>
                    <Style TargetType="Thumb">
                      <Setter Property="Width" Value="16" />
                      <Setter Property="Height" Value="16" />
                      <Setter Property="Cursor" Value="Hand" />
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="Thumb">
                            <Ellipse x:Name="ThumbChrome"
                                     Fill="#6FA8FF"
                                     Stroke="#D9FFFFFF"
                                     StrokeThickness="1" />
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Fill" Value="#85B7FF" />
                              </Trigger>
                              <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Fill" Value="#9CC5FF" />
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </Slider.Resources>
                  <Slider.Template>
                    <ControlTemplate TargetType="Slider">
                      <Grid Height="20" VerticalAlignment="Center">
                        <Border Height="4"
                                Background="#2B000000"
                                BorderBrush="#38FFFFFF"
                                BorderThickness="1"
                                CornerRadius="2"
                                VerticalAlignment="Center" />
                        <Track x:Name="PART_Track">
                          <Track.DecreaseRepeatButton>
                            <RepeatButton Command="Slider.DecreaseLarge"
                                          Background="#6FA8FF"
                                          BorderThickness="0">
                              <RepeatButton.Template>
                                <ControlTemplate TargetType="RepeatButton">
                                  <Border Background="{TemplateBinding Background}"
                                          CornerRadius="2" Height="4"
                                          VerticalAlignment="Center" />
                                </ControlTemplate>
                              </RepeatButton.Template>
                            </RepeatButton>
                          </Track.DecreaseRepeatButton>
                          <Track.Thumb>
                            <Thumb />
                          </Track.Thumb>
                          <Track.IncreaseRepeatButton>
                            <RepeatButton Command="Slider.IncreaseLarge"
                                          Background="Transparent"
                                          BorderThickness="0" />
                          </Track.IncreaseRepeatButton>
                        </Track>
                      </Grid>
                    </ControlTemplate>
                  </Slider.Template>
                </Slider>
                <Grid Grid.Column="2">
                  <TextBox x:Name="OpacityPercentBox"
                           Style="{StaticResource GlassTextBox}"
                           Height="38" Padding="8,7,24,7"
                           MaxLength="3"
                           TextAlignment="Center"
                           VerticalContentAlignment="Center" />
                  <TextBlock Text="%"
                             Foreground="{StaticResource SecondaryText}"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             Margin="0,0,9,0"
                             IsHitTestVisible="False" />
                </Grid>
              </Grid>
              <TextBlock Text="透明度越低，越能看清 HUD 后面的窗口内容；支持 0–100%。"
                         Foreground="{StaticResource SecondaryText}"
                         FontSize="11"
                         Margin="0,7,0,0" />
            </StackPanel>
          </Border>

          <TextBlock Text="CalDAV 账号" FontSize="15" FontWeight="SemiBold" />
          <StackPanel x:Name="AccountsPanel" Margin="0,10,0,18" />

          <Border Background="#1FFFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="12" Padding="16">
            <StackPanel>
              <TextBlock Text="添加账号" FontSize="15" FontWeight="SemiBold" />
              <TextBlock Text="密码只写入 Windows Credential Manager" Foreground="{StaticResource SecondaryText}" FontSize="11" Margin="0,3,0,14" />

              <TextBlock Text="名称" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,5" />
              <TextBox x:Name="AccountNameBox" Style="{StaticResource GlassTextBox}" Text="Radicale" />

              <TextBlock Text="CalDAV HTTPS 地址" Foreground="{StaticResource SecondaryText}" Margin="0,13,0,5" />
              <TextBox x:Name="UrlBox" Style="{StaticResource GlassTextBox}" ToolTip="例如 https://dav.example.com/username/" />

              <Grid Margin="0,13,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="用户名" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,5" />
                  <TextBox x:Name="UsernameBox" Style="{StaticResource GlassTextBox}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="密码" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,5" />
                  <PasswordBox x:Name="PasswordBox" Height="38" Padding="10,7" />
                </StackPanel>
              </Grid>

              <Grid Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ConnectionStatusText" Foreground="{StaticResource SecondaryText}"
                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Grid.Column="1" x:Name="ConnectButton" Content="连接并发现清单"
                        Background="#6FA8FF" Foreground="White" BorderThickness="0" Padding="16,10"
                        Click="Connect_Click" />
              </Grid>
            </StackPanel>
          </Border>

          <TextBlock Text="任务清单" FontSize="15" FontWeight="SemiBold" Margin="0,22,0,5" />
          <TextBlock Text="勾选决定是否显示；点击色块切换颜色。" Foreground="{StaticResource SecondaryText}" FontSize="11" />
          <StackPanel x:Name="CalendarsPanel" Margin="0,10,0,0" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</Window>

