<Window x:Class="FloatingTodo.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑任务" Width="520" Height="670"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Border Background="#F21B191E" BorderBrush="#42FFFFFF" BorderThickness="1" CornerRadius="16" Padding="24">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,20" MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="编辑任务" FontSize="21" FontWeight="SemiBold" />
          <TextBlock Text="修改后关闭自动保存，CalDAV 任务同步到服务器" Foreground="{StaticResource SecondaryText}" FontSize="12" Margin="0,4,0,0" />
        </StackPanel>
        <Button Grid.Column="1" Content="✕" Style="{StaticResource IconButton}" FontSize="15" Click="Close_Click" />
      </Grid>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="标题" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,6" />
          <TextBox x:Name="TitleBox" Style="{StaticResource GlassTextBox}" FontSize="17" />

          <TextBlock Text="所属清单" Foreground="{StaticResource SecondaryText}" Margin="0,18,0,6" />
          <ComboBox x:Name="ListBox" Height="38" DisplayMemberPath="Name" SelectedValuePath="Id" />

          <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="115" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="开始日期" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,6" />
              <DatePicker x:Name="StartDatePicker" Height="38" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="时间" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,6" />
              <TextBox x:Name="StartTimeBox" Style="{StaticResource GlassTextBox}" ToolTip="例如 09:30" />
            </StackPanel>
          </Grid>

          <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="115" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="截止日期" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,6" />
              <DatePicker x:Name="DueDatePicker" Height="38" SelectedDateChanged="DueDatePicker_SelectedDateChanged" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="时间（可选）" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,6" />
              <TextBox x:Name="DueTimeBox" Style="{StaticResource GlassTextBox}" ToolTip="例如 17:00" />
            </StackPanel>
          </Grid>

          <TextBlock Text="优先级" Foreground="{StaticResource SecondaryText}" Margin="0,18,0,6" />
          <ComboBox x:Name="PriorityBox" Height="38" />

          <TextBlock Text="描述" Foreground="{StaticResource SecondaryText}" Margin="0,18,0,6" />
          <TextBox x:Name="DescriptionBox" Style="{StaticResource GlassTextBox}" Height="100"
                   AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

          <TextBlock Text="高级重复规则" Foreground="{StaticResource SecondaryText}" Margin="0,18,0,6" />
          <ComboBox x:Name="RecurrencePresetBox" Height="38" Margin="0,0,0,8" SelectionChanged="RecurrencePresetBox_SelectionChanged" />
          <StackPanel x:Name="RecurrencePanel" Visibility="Collapsed" Margin="0,0,0,10">
            <TextBlock Text="频率与间隔" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,6" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
              <ComboBox x:Name="FrequencyBox" Height="38" SelectionChanged="RecurrenceOptions_SelectionChanged" />
              <TextBox Grid.Column="2" x:Name="IntervalBox" Text="1" ToolTip="每隔几个周期重复" />
            </Grid>
            <StackPanel x:Name="WeeklyPanel" Margin="0,10,0,0" Visibility="Collapsed">
              <TextBlock Text="每周哪些天（不选时沿用起始日）" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,6" />
              <WrapPanel x:Name="WeekdayPanel" />
            </StackPanel>
            <StackPanel x:Name="MonthlyPanel" Margin="0,10,0,0" Visibility="Collapsed">
              <ComboBox x:Name="MonthModeBox" Height="38" SelectionChanged="RecurrenceOptions_SelectionChanged" />
              <TextBox x:Name="MonthDaysBox" Margin="0,8,0,0" Text="1" Visibility="Collapsed" ToolTip="逗号分隔日期，如 1,15,-1；-1 表示最后一天" />
              <Grid x:Name="MonthWeekPanel" Margin="0,8,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <ComboBox x:Name="PositionBox" Height="38" />
                <ComboBox Grid.Column="2" x:Name="MonthWeekdayBox" Height="38" />
              </Grid>
            </StackPanel>
            <TextBlock Text="结束条件" Foreground="{StaticResource SecondaryText}" Margin="0,10,0,6" />
            <ComboBox x:Name="EndModeBox" Height="38" SelectionChanged="RecurrenceOptions_SelectionChanged" />
            <TextBox x:Name="CountBox" Margin="0,8,0,0" Text="10" Visibility="Collapsed" ToolTip="总次数包含第一次" />
            <DatePicker x:Name="UntilPicker" Height="38" Margin="0,8,0,0" Visibility="Collapsed" />
          </StackPanel>
          <TextBox x:Name="RecurrenceBox" Style="{StaticResource GlassTextBox}" ToolTip="例如 FREQ=WEEKLY;BYDAY=MO,WE,FR" />
          <TextBlock Text="高级配置在关闭时生成规则。原始 RRULE 模式支持更多组合；无法用表单表示的已有规则会自动保留在此模式。重复任务需要开始或截止日期。"
                     Foreground="{StaticResource SecondaryText}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
      </ScrollViewer>

      <Grid Grid.Row="2" Margin="0,20,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button x:Name="DeleteButton" Content="删除任务" Foreground="#FF8A86" Background="Transparent"
                BorderBrush="#45FF8A86" BorderThickness="1" Padding="14,8" Click="Delete_Click" />
        <TextBlock Grid.Column="1" x:Name="ValidationText" Foreground="#FF8A86" VerticalAlignment="Center"
                   TextAlignment="Right" Margin="16,0" TextWrapping="Wrap" />
        <Button Grid.Column="2" Content="撤销本次编辑" Foreground="{StaticResource PrimaryText}"
                Background="#22FFFFFF" BorderThickness="0" Padding="14,9" Click="Discard_Click" />
      </Grid>
    </Grid>
  </Border>
</Window>
