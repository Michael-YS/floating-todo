<Window x:Class="FloatingTodo.ConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="解决同步冲突" Width="780" Height="690"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Border Background="#F51B191E" BorderBrush="#45FFFFFF" BorderThickness="1" CornerRadius="16" Padding="24">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="解决同步冲突" FontSize="22" FontWeight="SemiBold" />
          <TextBlock x:Name="CounterText" Foreground="{StaticResource SecondaryText}" FontSize="12" Margin="0,4,0,0" />
        </StackPanel>
        <Button Grid.Column="1" Content="✕" Style="{StaticResource IconButton}" Click="Close_Click" />
      </Grid>

      <Grid Grid.Row="1" Margin="0,18,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="130" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="150" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="字段" Foreground="{StaticResource SecondaryText}" />
        <TextBlock Grid.Column="1" Text="本机版本" Foreground="{StaticResource SecondaryText}" />
        <TextBlock Grid.Column="2" Text="服务器版本" Foreground="{StaticResource SecondaryText}" />
        <TextBlock Grid.Column="3" Text="选择" Foreground="{StaticResource SecondaryText}" />
      </Grid>

      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="FieldsPanel" />
      </ScrollViewer>

      <Grid Grid.Row="3" Margin="0,18,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="默认保留本机字段；逐项勾选可采用服务器版本。"
                   Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="确认合并并重新同步" Background="#6FA8FF" Foreground="White"
                BorderThickness="0" Padding="18,10" Click="Resolve_Click" />
      </Grid>
    </Grid>
  </Border>
</Window>

